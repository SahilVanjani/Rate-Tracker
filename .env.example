# Environment – copy this file to .env and fill in real values
# NEVER commit the real .env

# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to "demo" to run with synthetic data (no API credentials needed)
# Omit or set to "live" for production.
RADAR_MODE=demo

# ── Zipaworld API ─────────────────────────────────────────────────────────────
# Base URL of the Zipaworld API  (e.g. https://api.zipaworld.com/v1)
ZIPAWORLD_BASE_URL=

# Path to the rates endpoint relative to base URL (e.g. /rates or /freight/rates)
ZIPAWORLD_RATES_PATH=

# Auth mode: "header" | "bearer"
# header = sends a custom header (name set by ZIPAWORLD_AUTH_HEADER_NAME)
# bearer = sends Authorization: Bearer <token>
ZIPAWORLD_AUTH_MODE=

# For auth mode "header": the name of the custom header
ZIPAWORLD_AUTH_HEADER_NAME=

# The API key or token value  (NEVER commit a real value)
ZIPAWORLD_API_KEY=

# Optional: client ID if the API requires an additional client ID
ZIPAWORLD_CLIENT_ID=

# Dotted path to the array of rate items in the JSON response
# Examples: "data", "data.rates", "result.items"
ZIPAWORLD_ITEMS_PATH=

# Pagination style: none | page | offset | cursor
ZIPAWORLD_PAGINATION_STYLE=

# For "page" style: query-param names for page number and page size
ZIPAWORLD_PAGE_PARAM=
ZIPAWORLD_PAGE_SIZE_PARAM=
ZIPAWORLD_PAGE_SIZE=100

# For "offset" style: query-param names for offset and limit
ZIPAWORLD_OFFSET_PARAM=
ZIPAWORLD_LIMIT_PARAM=

# For "cursor" style: query-param name for the cursor value, and dotted path to
# the next cursor in the response JSON
ZIPAWORLD_CURSOR_PARAM=
ZIPAWORLD_NEXT_CURSOR_PATH=

# Maximum pages to fetch (safety cap, all styles)
ZIPAWORLD_MAX_PAGES=500

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Timezone for expiry calculations (IANA tz name, default Asia/Kolkata)
RADAR_TIMEZONE=Asia/Kolkata

# Days before expiry that counts as "expiring soon" (1–90)
RADAR_EXPIRY_THRESHOLD=14

# Minimum distinct carrier brands required for "COVERED" status (1–10)
RADAR_MIN_CARRIERS=2

# Auto-sync interval in minutes (0 = disabled)
RADAR_SYNC_INTERVAL=60

# Optional admin token to protect watchlist edits and manual sync
# Leave blank to allow unauthenticated access (suitable for local use)
RADAR_ADMIN_TOKEN=
